# Use senha longa alfanumérica (URL do PostgreSQL).
POSTGRES_PASSWORD=troquePorUmaSenhaAleatoriaLonga
ORIGIN=http://localhost:8080
# false somente no desenvolvimento HTTP local. true obrigatório com HTTPS.
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
REGISTRATION_MODE=invite
# Gere: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Preserve e faça backup desta chave junto ao banco. Nunca publique.
AUTH_ENCRYPTION_KEY=
REQUIRE_MFA_ADMIN=true
SESSION_HOURS=8
SESSION_IDLE_MINUTES=30
APP_ENV=development
AUTO_SETUP=true
AUTO_OFFICIAL_SYNC=true
OFFICIAL_SYNC_HOURS=6
REGULATORY_NOTICE_MAX_HOURS=24
SOURCE_MAX_AGE_DAYS=7
# Execução sem Docker: descomente e ajuste (não usado pelo Compose).
# DATABASE_URL=postgresql+psycopg://bethunter:senha@localhost:5432/bethunter

# API pública RIPEstat. IP observado é enviado ao serviço quando habilitada.
ENRICH_ASN=false

OFFICIAL_SOURCE_URL=https://www.gov.br/fazenda/pt-br/composicao/orgaos/secretaria-de-premios-e-apostas/transparencia-ativa-processos-de-autorizacao-de-apostas-de-quota-fixa/empresas-autorizadas

# Descoberta por fontes autorizadas. Não varre a internet.
DISCOVERY_ALLOWED_HOSTS=raw.githubusercontent.com
AUTO_ANALYSES_PER_DAY=100
AUTO_ANALYSIS_DELAY_SECONDS=30
AUTO_QUEUE_LIMIT=1000

# Execute python3 scripts/configure.py para gerar os segredos faltantes.
POSTGRES_ADMIN_PASSWORD=
APP_DATABASE_PASSWORD=
MIGRATOR_PASSWORD=
BACKUP_ENCRYPTION_KEY=
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
BACKUP_MAX_BYTES=256000000
REPORT_STORAGE_LIMIT_MB=100
REPORT_MAX_SNAPSHOT_BYTES=2000000
REPORT_MAX_PDF_BYTES=5000000
REPORT_MAX_HISTORY=50
# Arquivamento somente de PDFs preparados antigos, mantendo evidências/metadados,
# com backup recente concluído. Desabilitado até validar a restauração.
REPORT_RETENTION_ENABLED=false
REPORT_RETENTION_DAYS=90
REPORT_MINIMUM_KEEP=3
RAW_DOCUMENT_STORAGE_LIMIT_MB=100
BACKLOG_ALERT_HOURS=48

# Servidor SMTP LOCAL DE TESTE criado pelo projeto. Não entrega para a internet.
SMTP_MODE=local
SMTP_HOST=maildev
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@bethunter.local
SMTP_STARTTLS=true
REQUIRE_EMAIL_VERIFICATION=false
# Produção: SMTP_MODE=smtp, host/porta/credenciais reais, verificação=true, HTTPS.

COMPOSE_NETWORK_SUBNET=172.29.0.0/24
COMPOSE_PROXY_IP=172.29.0.10
